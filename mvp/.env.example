# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32  (CREDS_KEY / JWT secrets), openssl rand -hex 16 (CREDS_IV)
LITELLM_MASTER_KEY=sk-change-me
POSTGRES_PASSWORD=change-me

# OpenRouter (MVP host). Create a key at openrouter.ai/keys. FAKE DATA ONLY until we move to an EU host.
OPENROUTER_API_KEY=

# LibreChat
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
ALLOW_REGISTRATION=true
