# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32  (CREDS_KEY / JWT secrets), openssl rand -hex 16 (CREDS_IV)
LITELLM_MASTER_KEY=sk-change-me
POSTGRES_PASSWORD=change-me

# OpenRouter (MVP host). Create a key at openrouter.ai/keys. FAKE DATA ONLY until we move to an EU host.
OPENROUTER_API_KEY=

# Public address of the app. For a real server: DOMAIN=chat.yourcompany.com and PUBLIC_URL=https://chat.yourcompany.com
DOMAIN=localhost
PUBLIC_URL=http://localhost

# What we add on top of the real model cost, and the exchange rate shown on the 'Mi gasto' page
APP_TITLE=Asistente
MARKUP=0.30
# Monthly spending limit in euros for the whole account (0 = no limit). Warns at 80%, stops at 100%.
MONTHLY_CAP_EUR=0
EUR_PER_USD=0.92

# Optional: Brave Search key for better research (about $5 per 1,000 searches). Empty = free search.
BRAVE_API_KEY=

# Admin password hash for the spending page /gasto (install.sh generates it; user name: admin)
ADMIN_HASH=
# "test" = OpenRouter, fake data only. Switch to "eu" only when every model host is EU-owned with no-log and no-training terms.
HOSTING_MODE=test
MODEL_HOSTS=
# Conversations are deleted automatically after this many days
RETENTION_DAYS=90
# Passphrase that encrypts backups (install.sh generates it). Keep a copy somewhere safe, away from the server.
BACKUP_PASSPHRASE=

# --- How staff log in: Google OR Microsoft (install.sh fills these in) ---
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOWED_REGISTRATION_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/oauth/google/callback
OPENID_ISSUER=
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_SESSION_SECRET=
OPENID_SCOPE=openid profile email
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL=Entrar con Microsoft

# LibreChat
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
ALLOW_REGISTRATION=true
