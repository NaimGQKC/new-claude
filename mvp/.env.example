# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -hex 32  (CREDS_KEY / JWT secrets), openssl rand -hex 16 (CREDS_IV)
LITELLM_MASTER_KEY=sk-change-me
POSTGRES_PASSWORD=change-me

# One EU-hosted OpenAI-compatible provider (see research_notes/.../eu_hosting.md for options).
EU_API_BASE=https://api.example-eu-host.com/v1
EU_API_KEY=

# LibreChat
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
ALLOW_REGISTRATION=true
